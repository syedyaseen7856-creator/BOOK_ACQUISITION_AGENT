# ==========================================
# SyllExtract Book Acquisition Agent Config
# ==========================================

# Application Server
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Google Gemini Flash API Key (for ambiguous rights verification and query refinement)
# If left empty, the application uses rule-based heuristics and mock reasoning.
GEMINI_API_KEY=

# Google Books API Key (Optional: works with default public quota if empty)
GOOGLE_BOOKS_API_KEY=

# Web Search Provider: "mock", "duckduckgo", "searxng", or "google"
SEARCH_PROVIDER=mock

# Allowed Domains for download & repository links (comma-separated)
ALLOWED_DOMAINS=gutenberg.org,archive.org,openlibrary.org,doabooks.org,books.google.com,gutendex.com,pages.cs.wisc.edu,wisc.edu

# Safety Limits
MAX_FILE_SIZE_MB=50
REQUEST_TIMEOUT_SECONDS=15

# Storage Directory for audit trails and approved downloads
STORAGE_DIR=./data
